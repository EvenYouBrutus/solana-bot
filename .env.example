# Real historical data pipeline environment variables.
#
# Copy this file to .env and fill in the values. NEVER commit the .env file.
#
# Required for `cargo run --release -- historical-build`:
#
#   BIRDEYE_API_KEY      Your Birdeye (or Birdeye-compatible) API key.
#                        Sent in the X-API-KEY header on every OHLCV
#                        request. Get one at https://birdeye.so/.
#
# Optional overrides for the OHLCV provider:
#
#   OHLCV_PROVIDER_URL   Override the OHLCV provider endpoint.
#                        Default: https://public-api.birdeye.so
#
#   OHLCV_CACHE_DIR      Override the cache directory.
#                        Default: data/historical_cache
#
# Required for safety / wallet reconstruction (Solana RPC):
#
#   SOLANA_RPC_URL       Full Solana JSON-RPC endpoint URL.
#                        Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#                        If unset, the pipeline falls back to HELIUS_API_KEY
#                        (helius-rpc mainnet) and finally to the public
#                        Solana mainnet RPC (rate-limited, not recommended).
#
#   HELIUS_API_KEY       Helius API key, used to auto-derive SOLANA_RPC_URL
#                        when SOLANA_RPC_URL is not set.
#
# The live trading signer / Jupiter keypair environment variables used
# by `cargo run --release -- run` are documented in config.example.toml
# and are NOT needed for `historical-build`.

BIRDEYE_API_KEY=
SOLANA_RPC_URL=
HELIUS_API_KEY=